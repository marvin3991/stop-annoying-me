<Window
    x:Class="StopAnnoyingMe.App.Views.RecordEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="編輯記錄"
    Width="380"
    Height="430"
    Icon="../Assets/app.ico"
    ShowInTaskbar="False"
    Style="{StaticResource Style.Window.Dialog}"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,0,6,0">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource Style.Text.Body}"
                Text="編輯記錄" />
            <Button
                HorizontalAlignment="Right"
                Click="OnCancelClick"
                Style="{StaticResource Style.Button.Icon}"
                ToolTip="關閉">
                <Path
                    Data="{StaticResource Geometry.Close}"
                    Stretch="None"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.6" />
            </Button>
        </Grid>

        <!--  發生時間：唯讀，編輯不會動到它  -->
        <Border
            Grid.Row="1"
            Margin="16,4,16,0"
            Padding="14,12"
            Style="{StaticResource Style.Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Style.Text.Muted}" Text="發生時間（不可修改）" />
                <TextBlock
                    x:Name="TimeText"
                    Margin="0,6,0,0"
                    Style="{StaticResource Style.Text.Title}" />
                <TextBlock
                    x:Name="DateText"
                    Margin="0,2,0,0"
                    Style="{StaticResource Style.Text.Muted}" />
            </StackPanel>
        </Border>

        <!--  來源：點一次選取、再點一次取消  -->
        <Border
            Grid.Row="2"
            Margin="16,10,16,0"
            Padding="14,12"
            Style="{StaticResource Style.Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Style.Text.Muted}" Text="來源（再點一次可取消）" />
                <ItemsControl x:Name="ChipList" Margin="0,10,0,-6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="0,0,6,6"
                                Click="OnChipClick"
                                Content="{Binding Name}"
                                Style="{StaticResource Style.Button.Chip}"
                                Tag="{Binding TagValue}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--  備註  -->
        <Border
            Grid.Row="3"
            Margin="16,10,16,0"
            Padding="14,12"
            Style="{StaticResource Style.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource Style.Text.Muted}"
                    Text="備註" />
                <TextBox
                    x:Name="NoteBox"
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    AcceptsReturn="True"
                    MaxLength="500"
                    Style="{StaticResource Style.TextBox}"
                    TextWrapping="Wrap"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto">
                    <TextBox.Resources>
                        <Style BasedOn="{StaticResource Style.ScrollBar.Thin}" TargetType="{x:Type ScrollBar}" />
                    </TextBox.Resources>
                </TextBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="16,10,16,16">
            <TextBlock
                x:Name="ErrorText"
                Margin="0,0,0,8"
                Foreground="{StaticResource Brush.Danger}"
                Style="{StaticResource Style.Text.Caption}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!--  一般狀態  -->
            <Grid x:Name="NormalActions">
                <Button
                    HorizontalAlignment="Left"
                    Click="OnDeleteClick"
                    Content="刪除這筆"
                    Style="{StaticResource Style.Button.Danger.Subtle}"
                    ToolTip="把這筆記錄從資料庫刪掉" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Click="OnCancelClick"
                        Content="取消"
                        IsCancel="True"
                        Style="{StaticResource Style.Button.Secondary}" />
                    <Button
                        Click="OnSaveClick"
                        Content="儲存"
                        Style="{StaticResource Style.Button.Secondary}" />
                </StackPanel>
            </Grid>

            <!--  刪除確認：刪除無法復原，一定要再問一次  -->
            <Grid x:Name="DeleteConfirm" Visibility="Collapsed">
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource Brush.Danger}"
                    Style="{StaticResource Style.Text.Caption}"
                    Text="刪除後無法復原" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Click="OnDeleteCancelClick"
                        Content="不要"
                        Style="{StaticResource Style.Button.Secondary}" />
                    <Button
                        x:Name="DeleteConfirmButton"
                        Click="OnDeleteConfirmClick"
                        Content="確定刪除"
                        Style="{StaticResource Style.Button.Danger}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
