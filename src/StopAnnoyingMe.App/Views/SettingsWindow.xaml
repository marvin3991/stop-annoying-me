<Window
    x:Class="StopAnnoyingMe.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="設定"
    Width="460"
    Height="600"
    Icon="../Assets/app.ico"
    ShowInTaskbar="False"
    Style="{StaticResource Style.Window.Dialog}"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,0,6,0">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource Style.Text.Body}"
                Text="設定" />
            <Button
                HorizontalAlignment="Right"
                Click="OnCancelClick"
                Style="{StaticResource Style.Button.Icon}"
                ToolTip="關閉">
                <Path
                    Data="{StaticResource Geometry.Close}"
                    Stretch="None"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.6" />
            </Button>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Margin="16,4,16,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <!--  用主題的細捲軸，不要 Windows 預設的粗捲軸  -->
                <Style BasedOn="{StaticResource Style.ScrollBar.Thin}" TargetType="{x:Type ScrollBar}" />
            </ScrollViewer.Resources>
            <StackPanel>

                <!--  熱鍵  -->
                <Border Margin="0,0,0,10" Padding="14,12" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="全域熱鍵" />
                        <CheckBox
                            x:Name="HotkeyEnabledCheck"
                            Margin="0,10,0,0"
                            Content="啟用全域熱鍵"
                            Style="{StaticResource Style.CheckBox}" />
                        <TextBox
                            x:Name="HotkeyBox"
                            Margin="0,10,0,0"
                            IsEnabled="{Binding IsChecked, ElementName=HotkeyEnabledCheck}"
                            IsReadOnly="True"
                            PreviewKeyDown="OnHotkeyPreviewKeyDown"
                            Style="{StaticResource Style.TextBox}" />
                        <TextBlock
                            x:Name="HotkeyHint"
                            Margin="2,6,0,0"
                            Style="{StaticResource Style.Text.Muted}"
                            Text="點一下上面的欄位，再直接按下想用的組合鍵（需含 Ctrl／Alt／Shift／Win）。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  視窗行為  -->
                <Border Margin="0,0,0,10" Padding="14,12" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="視窗行為" />
                        <CheckBox
                            x:Name="AlwaysOnTopCheck"
                            Margin="0,10,0,0"
                            Content="視窗永遠置頂"
                            Style="{StaticResource Style.CheckBox}" />
                        <CheckBox
                            x:Name="MinimizeToTrayCheck"
                            Margin="0,10,0,0"
                            Content="按關閉時收到系統匣，不結束程式"
                            Style="{StaticResource Style.CheckBox}" />
                        <CheckBox
                            x:Name="RunAtStartupCheck"
                            Margin="0,10,0,0"
                            Content="開機時自動啟動"
                            Style="{StaticResource Style.CheckBox}" />
                    </StackPanel>
                </Border>

                <!--  記錄行為  -->
                <Border Margin="0,0,0,10" Padding="14,12" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="記錄行為" />
                        <TextBlock
                            Margin="0,10,0,0"
                            Style="{StaticResource Style.Text.Caption}"
                            Text="手滑保護秒數（0 表示關閉）" />
                        <TextBox
                            x:Name="GuardSecondsBox"
                            Width="90"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            MaxLength="4"
                            Style="{StaticResource Style.TextBox}" />
                        <TextBlock
                            Margin="2,6,0,0"
                            Style="{StaticResource Style.Text.Muted}"
                            Text="距上一筆未滿這個秒數的重複觸發不會被記錄。"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,16,0,0"
                            Style="{StaticResource Style.Text.Caption}"
                            Text="可選標籤（用逗號分隔，最多 8 個）" />
                        <TextBox
                            x:Name="SourcesBox"
                            Margin="0,6,0,0"
                            Style="{StaticResource Style.TextBox}" />
                    </StackPanel>
                </Border>

                <!--  資料位置  -->
                <Border Margin="0,0,0,10" Padding="14,12" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="資料位置" />
                        <TextBlock
                            x:Name="DataPathText"
                            Margin="0,8,0,0"
                            Style="{StaticResource Style.Text.Caption}"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Click="OnOpenFolderClick"
                            Content="開啟資料夾"
                            Style="{StaticResource Style.Button.Secondary}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="16,12,16,16">
            <TextBlock
                x:Name="ErrorText"
                VerticalAlignment="Center"
                Foreground="{StaticResource Brush.Danger}"
                Style="{StaticResource Style.Text.Caption}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Click="OnCancelClick"
                    Content="取消"
                    Style="{StaticResource Style.Button.Secondary}" />
                <Button
                    Click="OnSaveClick"
                    Content="儲存"
                    Style="{StaticResource Style.Button.Secondary}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
