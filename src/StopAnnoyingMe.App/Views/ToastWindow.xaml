<Window
    x:Class="StopAnnoyingMe.App.Views.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="打擾記錄器提示"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    Topmost="True"
    WindowStyle="None">
    <Border
        x:Name="Frame"
        MinWidth="180"
        Padding="18,12"
        Background="{StaticResource Brush.Surface}"
        BorderBrush="{StaticResource Brush.Accent}"
        BorderThickness="1"
        CornerRadius="{StaticResource Radius.Button}">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource Style.Text.Title}" />
            <TextBlock
                x:Name="BodyText"
                Margin="0,4,0,0"
                Style="{StaticResource Style.Text.Caption}" />
        </StackPanel>
    </Border>
</Window>
